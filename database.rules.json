{
  "rules": {
    ".read": "auth !== null",
    ".write": "auth !== null",
    "users": {
      ".read": "auth != null && root.child('users/'+auth.uid+'/isAdmin').val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users/'+auth.uid+'/isAdmin').val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('users/'+auth.uid+'/isAdmin').val() === true)",
        "blocked": {
          ".write": "(auth != null && auth.uid === $uid && !root.child('users/'+$uid).exists()) || (auth != null && root.child('users/'+auth.uid+'/isAdmin').val() === true)"
        },
        "isAdmin": {
          ".write": "(auth != null && auth.uid === $uid && !root.child('users/'+$uid).exists()) || (auth != null && root.child('users/'+auth.uid+'/isAdmin').val() === true)"
        }
      }
    },
    "sessions": {
      ".read": true,
      ".indexOn": "localTs",
      "$sid": {
        ".write": true,
        ".validate": "newData.hasChildren(['localTs']) && newData.child('localTs').isNumber() && newData.child('localTs').val() <= now + 300000"
      }
    },
    "chat": {
      "messages": {
        ".indexOn": "timestamp",
        "$mid": {
          ".validate": "newData.hasChildren(['text','timestamp']) && newData.child('text').isString() && newData.child('timestamp').isNumber()"
        }
      },
      "likes": {
        "$mid": {
          "$uid": {
            ".validate": "newData.val() === true"
          }
        }
      },
      "banned": {
        "$uid": {
          ".validate": "newData.hasChildren(['bannedAt']) && newData.child('bannedAt').isNumber() && newData.child('bannedAt').val() <= now"
        }
      },
      "online": {
        ".indexOn": "timestamp",
        "$sid": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        }
      },
      "poll": {
        "active": { ".validate": "newData.isBoolean()" },
        "question": { ".validate": "newData.isString()" },
        "options": { ".validate": "newData.val() !== null" },
        "endsAt": { ".validate": "newData.isNumber()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "votes": {
          "$uid": { ".validate": "newData.isNumber()" }
        }
      }
    },
    "subscriptions": {
      "$uid": {
        ".validate": "newData.hasChildren(['email','active','activatedAt']) && newData.child('email').isString() && newData.child('active').isBoolean() && newData.child('activatedAt').isNumber()"
      }
    },
    "activations": {
      "$deviceId": {
        ".read": true,
        ".write": true
      }
    },
    "codes": {
      "$code": {
        ".read": true,
        ".write": "(auth != null && root.child('users/'+auth.uid+'/isAdmin').val() === true) || (data.exists() && newData.child('used').val() === true && newData.hasChildren(['usedBy','usedAt','createdAt','createdBy']))"
      }
    }
  }
}
