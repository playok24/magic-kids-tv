{
  "name": "magic-kids-desktop",
  "version": "1.4.2",
  "description": "Magic Kids Television - App de Escritorio",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "obfuscate": "node scripts/obfuscate.js",
    "build": "node scripts/obfuscate.js && electron-builder --win --config",
    "build-no-obfuscate": "electron-builder --win --config"
  },
  "build": {
    "appId": "com.magickids.desktop",
    "productName": "Magic Kids Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "electron-preload.js",
      "cast-service.js",
      "prueba.html",
      "www/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "playok24",
      "repo": "magic-kids-tv"
    },
    "win": {
      "target": "nsis",
      "sign": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "Magic-Kids-Desktop-Setup-${version}.${ext}"
    }
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "javascript-obfuscator": "^5.4.3"
  },
  "dependencies": {
    "@caprockapps/capacitor-chromecast": "^7.0.6",
    "castv2-client": "^1.2.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "multicast-dns": "^7.2.5"
  }
}
